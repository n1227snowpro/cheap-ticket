# Copy to ../.env (next to docker-compose.yml) on the server and fill in. Never commit the real file.

# ── Site ──
BASE_URL=https://invest.srv1213330.hstgr.cloud
SECRET_KEY=                       # python3 -c "import secrets; print(secrets.token_hex(32))"
ADMIN_EMAILS=you@example.com      # can open /admin (after confirming the e-mail)

# ── Data ──
EODHD_KEY=                        # empty = demo mode with fictional companies
ANTHROPIC_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
SEC_USER_AGENT=StockRadar you@example.com

# ── Stripe ── (python3 investor/scripts/stripe_setup.py prints the price IDs)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTH=
STRIPE_PRICE_PRO_YEAR=
STRIPE_PRICE_PREMIUM_MONTH=
STRIPE_PRICE_PREMIUM_YEAR=
TRIAL_DAYS=7

# ── Google sign-in ── (redirect URI: https://<domain>/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── E-mail (verification, password reset, alerts) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=StockRadar <no-reply@yourdomain.com>
